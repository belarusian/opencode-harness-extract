{
  "name": "@belarusian/llm",
  "version": "0.1.0",
  "description": "Standalone LLM client — Effect-based client for LLM API calls with streaming, agent loop, tool execution, and caching.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@smithy/eventstream-codec": "4.2.14",
    "@smithy/util-utf8": "4.2.2",
    "aws4fetch": "1.0.20",
    "effect": "4.0.0-beta.70"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "llm",
    "effect",
    "opencode",
    "agent",
    "local-inference"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/belarusian/opencode-harness-extract.git"
  }
}
